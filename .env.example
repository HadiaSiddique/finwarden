# Copy to .env and fill in. Never commit .env.

# PayPal sandbox (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Must stay the sandbox URL; anything else is refused at startup.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Set after registering the webhook on the deployed URL.
PAYPAL_WEBHOOK_ID=

# AI: free tiers, no card. Gemini key from aistudio.google.com, Groq key from console.groq.com.
# Pick current free-tier models from each provider's rate-limit page.
AI_PROVIDER=google
AI_MODEL=
AI_FAST_MODEL=
GOOGLE_GENERATIVE_AI_API_KEY=
AI_FALLBACK_PROVIDER=groq
AI_FALLBACK_MODEL=
GROQ_API_KEY=
# Caps so judges can't exhaust the free quota.
AI_MAX_CALLS_PER_SESSION_PER_HOUR=30
AI_MAX_CALLS_PER_DAY=200

# Database: Neon free Postgres in production. Leave empty locally to use PGlite.
DATABASE_URL=

# Trust layer
TWO_APPROVER_THRESHOLD_USD=1000
COOLING_OFF_HOURS=24

# Passkeys (WebAuthn): the deployed domain, or localhost in development
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# Demo mode: demo clock, scenario runner, reset button
DEMO_MODE=true
SESSION_SECRET=

# Sponsor tools (free trials only, no card). The app works without these.
AG_GRID_LICENSE_KEY=
BRYNTUM_LICENSE=
KERNEL_API_KEY=

# GitHub Actions calls protected job endpoints with this
CRON_SECRET=
