# Copy to .env and fill in. Never commit .env.

# PayPal sandbox (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Must stay the sandbox URL; anything else is refused at startup.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Set after registering the webhook on the deployed URL.
PAYPAL_WEBHOOK_ID=

# Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_FAST_MODEL=claude-haiku-5-5
# Spend caps so judges can't run up the bill.
AI_MAX_CALLS_PER_SESSION_PER_HOUR=60
AI_MAX_CALLS_PER_DAY=3000

# Database (Render Postgres in production)
DATABASE_URL=

# Trust layer
TWO_APPROVER_THRESHOLD_USD=1000
COOLING_OFF_HOURS=24

# Passkeys (WebAuthn): the deployed domain, or localhost in development
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# Demo mode: demo clock, scenario runner, reset button
DEMO_MODE=true
SESSION_SECRET=

# Sponsor tools
AG_GRID_LICENSE_KEY=
BRYNTUM_LICENSE=
KERNEL_API_KEY=
# Optional extras: the app works without these.
ELASTIC_CLOUD_ID=
ELASTIC_API_KEY=
ZAPIER_INBOX_SECRET=

# Render cron calls protected job endpoints with this
CRON_SECRET=
